# Copy to .env and edit. Only needed for src/detection's optional LLM layer
# (use_llm=True); the rest of the pipeline runs without it.

# LiteLLM model id. Default is a local Ollama model — no API key needed, but
# you must `ollama pull qwen2.5:7b` first (or point this at another model
# you've pulled).
DETECTION_LLM_MODEL=ollama_chat/qwen2.5:7b

# To use Gemini instead (as in the labs), set both of these and change
# DETECTION_LLM_MODEL above to e.g. gemini/gemini-1.5-flash.
# DETECTION_LLM_API_KEY=your-gemini-api-key
