# Copy to .env and edit. Only needed for src/detection's optional LLM layer
# (use_llm=True); the rest of the pipeline runs without it.

# LiteLLM model id. Default is a local Ollama model — no API key needed, but
# you must `ollama pull qwen2.5:7b` first (or point this at another model
# you've pulled).
DETECTION_LLM_MODEL=ollama_chat/qwen2.5:7b

# To use Gemini instead (as in the labs), set both of these and change
# DETECTION_LLM_MODEL above to e.g. gemini/gemini-3.8-flash. Check
# https://ai.google.dev/gemini-api/docs/models for the current model id —
# Gemini model names get retired over time. The free tier is rate-limited
# (requests/day and requests/minute caps) — evaluate.py's --llm-delay flag
# helps stay under it when running many events.
# DETECTION_LLM_API_KEY=your-gemini-api-key

# Per-event LLM wall-clock timeout, in seconds (default 20.0). Raise this on
# a slow local CPU model, or lower it to fail fast during development.
# DETECTION_LLM_TIMEOUT=20.0

# LLM mode: "agent" (default) uses the full ToolCallingAgent loop — for hosted models
# with real tool_choice support (e.g. Gemini). "single_shot" has code call the tools
# directly and makes one LLM call with a JSON schema response format instead — use
# this for local Ollama models: litellm's own ollama transformation drops tool_choice
# entirely, so the agent loop's "every step is a tool call" requirement can't be
# forced onto them (verified against ollama_chat/qwen2.5:3b).
# DETECTION_LLM_MODE=single_shot
