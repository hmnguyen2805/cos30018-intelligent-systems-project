# Copy to .env and edit. Everything here is optional: the tests and the
# rules-mode Judge run without any of it. Never commit .env.

# ---------------------------------------------------------------------------
# Detection's optional LLM layer (src/detection, use_llm=True)
# ---------------------------------------------------------------------------

# LiteLLM model id. Default is a local Ollama model — no API key needed, but
# you must `ollama pull qwen2.5:3b` first (or point this at another model
# you've pulled).
DETECTION_LLM_MODEL=ollama_chat/qwen2.5:3b

# To use Gemini instead (as in the labs), set both of these and change
# DETECTION_LLM_MODEL above to e.g. gemini/gemini-3.8-flash. Check
# https://ai.google.dev/gemini-api/docs/models for the current model id —
# Gemini model names get retired over time. The free tier is rate-limited
# (requests/day and requests/minute caps) — evaluate.py's --llm-delay flag
# helps stay under it when running many events.
# DETECTION_LLM_API_KEY=your-gemini-api-key

# Per-event LLM wall-clock timeout, in seconds (default 60.0 — local CPU models are
# slow). Lower it to fail fast during development, or raise it further on a very
# slow machine.
# DETECTION_LLM_TIMEOUT=60.0

# LLM mode: "agent" uses the full ToolCallingAgent loop — for hosted models with real
# tool_choice support (e.g. Gemini). "single_shot" has code call the tools directly
# and makes one LLM call with a JSON schema response format instead — required for
# local Ollama models: litellm's own ollama transformation drops tool_choice entirely,
# so the agent loop's "every step is a tool call" requirement can't be forced onto
# them (verified against ollama_chat/qwen2.5:3b). Left unset, this now defaults
# automatically based on DETECTION_LLM_MODEL: single_shot for any ollama_chat/* model,
# agent otherwise — so this only needs setting to override that default.
# DETECTION_LLM_MODE=single_shot

# ---------------------------------------------------------------------------
# Judge (src/response, see src/response/README.md)
# ---------------------------------------------------------------------------

# Judge mode for build_default_pipeline(): rules (no LLM), single_shot (one LLM
# call) or agent (the LLM agent loop, which can recheck). The UI has its own selector.
# JUDGE_MODE=rules

# LiteLLM model id for the Judge. Default: local Ollama (ollama pull qwen2.5:3b).
# JUDGE_LLM_MODEL=ollama_chat/qwen2.5:3b

# Only for hosted models (e.g. JUDGE_LLM_MODEL=gemini/<model id>).
# JUDGE_LLM_API_KEY=your-api-key

# Seconds per LLM call, agent-loop turns before falling back to the rules,
# and output tokens per call.
# JUDGE_LLM_TIMEOUT=60
# JUDGE_LLM_MAX_STEPS=6
# JUDGE_LLM_MAX_TOKENS=400
